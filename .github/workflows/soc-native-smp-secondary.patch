diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -143,8 +143,8 @@
 	adrp	x19, EXT(ResetHandlerData)@page			// Get address of the reset handler data
 	add		x19, x19, EXT(ResetHandlerData)@pageoff
 	mrs		x15, MPIDR_EL1						// Load MPIDR to get CPU number
-#if HAS_CLUSTER
-	and		x0, x15, #0xFFFF					// CPU number in Affinity0, cluster ID in Affinity1
+#if HAS_CLUSTER || defined(BCM2837)
+	and		x0, x15, #0xFFFF					// CPU number in Affinity0, cluster ID in Affinity1 (Qualcomm numbers cores in Affinity1)
 #else
 	and		x0, x15, #0xFF						// CPU number is in MPIDR Affinity Level 0
 #endif
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1248,7 +1248,7 @@
 		 * on the value provided by EDT. Instead, use the MPIDR value to see if we have
 		 * seen this exact cluster before. If so, then reuse that cluster ID for this CPU.
 		 */
-#if HAS_CLUSTER
+#if HAS_CLUSTER || defined(BCM2837)
 		uint32_t phys_cluster_id = MPIDR_CLUSTER_ID(cpu->phys_id);
 #else
 		uint32_t phys_cluster_id = (cpu->cluster_type == CLUSTER_TYPE_P);
